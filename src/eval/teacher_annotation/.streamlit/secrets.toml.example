# Copy to secrets.toml (gitignored) for local deploy testing, OR paste these
# into the Streamlit Community Cloud "Secrets" box when deploying.
#
# Streamlit exposes [secrets] as env vars too, so the app reads them via
# os.environ. For a Supabase project use the "Connection string" (URI), and
# swap the scheme to postgresql+psycopg2://

DATABASE_URL = "postgresql+psycopg2://postgres:YOUR-PASSWORD@db.YOUR-REF.supabase.co:5432/postgres"
ADMIN_PASSWORD = "choose-a-strong-password"